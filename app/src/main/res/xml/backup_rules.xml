<?xml version="1.0" encoding="utf-8" ?>
<full-backup-content>
    <!-- Room records reference device-local MediaStore IDs/URIs that may be stale after cloud restore. -->
    <exclude domain="database" path="rockstar.db" />
    <exclude domain="database" path="rockstar.db-shm" />
    <exclude domain="database" path="rockstar.db-wal" />
    <!-- Playback restore state is transient and should not move across devices. -->
    <exclude domain="file" path="playback_state.json" />
</full-backup-content>
