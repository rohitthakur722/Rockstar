<?xml version="1.0" encoding="utf-8" ?>
<data-extraction-rules>
    <cloud-backup>
        <!-- Keep user-created local references on this device; MediaStore URIs are not portable. -->
        <exclude domain="database" path="rockstar.db" />
        <exclude domain="database" path="rockstar.db-shm" />
        <exclude domain="database" path="rockstar.db-wal" />
        <exclude domain="file" path="playback_state.json" />
    </cloud-backup>
    <device-transfer>
        <!-- Device-to-device transfer uses the same conservative policy as cloud backup. -->
        <exclude domain="database" path="rockstar.db" />
        <exclude domain="database" path="rockstar.db-shm" />
        <exclude domain="database" path="rockstar.db-wal" />
        <exclude domain="file" path="playback_state.json" />
    </device-transfer>
</data-extraction-rules>
